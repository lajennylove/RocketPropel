      <a href="/" class="font-bold text-heading no-underline hover:no-underline">Propel</a>
      <span class="truncate text-[15px] text-text">Blade-inspired templating for Rocket.rs</span>
    </header>

    <div class="mx-auto flex max-w-[1280px] flex-col md:flex-row">
      <!-- The menu toggle. The label in the header controls it, and the sidebar
           follows it with peer-checked, so no JavaScript is needed. -->
      <input id="menu-toggle" type="checkbox" class="peer hidden">

      <aside class="hidden shrink-0 border-b border-hairline p-4 peer-checked:block md:block md:sticky md:top-14 md:h-[calc(100vh-3.5rem)] md:w-[300px] md:overflow-y-auto md:border-r md:border-b-0 md:p-6">
        <nav>
          @foreach (group in nav)
            <p class="sidebar-heading">{{ $group.heading }}</p>
            @foreach (link in group.links)
              <a class="sidebar-link" href="{{ $link.href }}">{{ $link.label }}</a>
            @endforeach
          @endforeach
        </nav>
      </aside>

      <main class="min-w-0 flex-1 px-6 py-10 md:px-12">
        <div class="docs-content">
          @yield('content')
        </div>

        <!-- Previous and next pages, in sidebar order. -->
        <nav class="docs-content mt-16 flex justify-between gap-4 border-t border-hairline pt-6" aria-label="Pages">
          @if ($pager.prev)
            <a href="{{ $pager.prev.href }}" class="group flex flex-col no-underline hover:no-underline">
              <span class="text-sm text-text">Previous</span>
              <span class="font-semibold text-accent group-hover:underline">{{ $pager.prev.label }}</span>
            </a>
          @endif
          @if ($pager.next)
            <a href="{{ $pager.next.href }}" class="group ml-auto flex flex-col text-right no-underline hover:no-underline">
              <span class="text-sm text-text">Next</span>
              <span class="font-semibold text-accent group-hover:underline">{{ $pager.next.label }}</span>
            </a>
          @endif
        </nav>
      </main>
    </div>
  </body>
</html>
