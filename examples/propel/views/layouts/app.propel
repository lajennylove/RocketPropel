  <body>
    <header class="sticky top-0 z-10 flex h-14 items-center gap-4 border-b border-hairline bg-header px-6">
      <label for="menu-toggle" class="cursor-pointer text-text md:hidden" aria-label="Toggle menu">
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"/>
