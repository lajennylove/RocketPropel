@section('content')
  <h1>Escaping</h1>

  <h2>Text is escaped</h2>
  <p>{{ $dangerous }}</p>

  <h2>Raw output</h2>
  <p>{!! $trusted !!}</p>

  <h2>URLs in attributes</h2>
  <p><a href="{{ $safe_url }}">Safe link</a>, shown as text: {{ $safe_url }}</p>
  <p><a href="{{ $unsafe_url }}">Unsafe link</a>, its href becomes #</p>
  <p><a href="{!! $unsafe_url !!}">Raw unsafe link</a>, still #</p>
  <p><a href="{{ $tab_url }}">Scheme hidden by a tab</a>, still #</p>

  <h2>Literal syntax</h2>
  <p>Mail me@example.com. Write <code>@@if (x)</code> and <code>@@@{{ $not_a_variable }}</code> as text.</p>
  <p><code>@foo</code> is plain text too, because it is not a known directive.</p>

  <h2>A code block</h2>
  <pre><code>&lt;p&gt;@{{ $dangerous }}&lt;/p&gt;</code></pre>
  <p>Braces in a code sample are written with a leading <code>@</code>, as in <code>@@@{{</code>, so the template does not run them.</p>
@endsection
